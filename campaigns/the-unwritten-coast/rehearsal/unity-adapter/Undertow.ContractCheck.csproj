<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Validation only: link current source without editing or replacing its assembly. -->
  <ItemGroup>
    <Compile Include="UndertowSceneAdapter.cs" />
    <Compile Include="../../../../RPG-Core/station/Assets/RpgIntegration/Contracts/*.cs" Link="CurrentContracts/%(Filename)%(Extension)" />
    <Compile Include="../../../../RPG-Core/station/Assets/RpgIntegration/Runtime/SceneServices.cs" Link="CurrentRuntime/SceneServices.cs" />
  </ItemGroup>
</Project>
