 document.querySelectorAll('#drawerBody form[data-action]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();const f=Object.fromEntries(new FormData(form));if(f.checkTotal!==undefined)f.checkTotal=Number(f.checkTotal);act({type:form.dataset.action,...f});}));
