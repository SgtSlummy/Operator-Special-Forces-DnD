    map=map.replace('</svg>',data.encounter.enemies.map(enemy=>`<g><image href="${portrait('sentinel')}" x="${(1000-w)/2+enemy.x*w-14}" y="${(650-h)/2+enemy.y*h-18}" width="28" height="36"/><title>${e(enemy.name)}</title></g>`).join('')+'</svg>');}
  }else if(view==='world')map=worldMap(data.catalog,data.state);
