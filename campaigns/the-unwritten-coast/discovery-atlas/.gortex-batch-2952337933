async function api(url,options={}){const r=await fetch(url,{...options,headers:{'X-Table-Key':key,...options.headers}});const v=await r.json();if(!r.ok)throw Error(v.error||'The table could not respond.');return v;}
async function refresh(silent=false){if(silent&&document.activeElement?.matches('input,textarea,select'))return;try{const next=await api('/api/view');if(silent&&data?.state.revision===next.state.revision)return;const following=!roomId||roomId===data?.state.currentRoomId;data=next;if(data.key)key=data.key;roomId=!following&&data.catalog.rooms.some(r=>r.id===roomId)?roomId:data.state.currentRoomId;areaId=current()?.areaId;render();if(!silent)notify('Your table is up to date.');}catch(err){notify(err.message,true);}}
