const result=()=>({text:JSON.stringify({approved:true,text:'You hear the rain outside. No mechanical effects are applied.'}),sources:[],trace:[{destination:'local'}]});
async function fixture({mode='ai_dm',generate=result,ambiguous=false,unresolved=false,pendingCount=1,onRefresh=()=>{},directory:providedDirectory,directorStore,recoveredCommand,beforeCommand=()=>{},recoveryFile,omitRecovery=false}={}){
 const directory=providedDirectory??await mkdtemp(join(tmpdir(),'director-runtime-')),requests=[],commands=[],recoveries=[],leases=new Map();let observer,member=true;
 const view={campaignId:'fixture',revision:4,currentSceneId:'briefing',directorMode:mode,authorityEpoch:1,aiDirectorId:'ai-director:fixture',decisionOpen:true,characters:[],pendingActions:[],rollPending:false};
 const empty=()=>({bootEpoch:'11111111-1111-4111-8111-111111111111',generation:null,sessionPolicyRevision:0,leaseExpiresAtMs:null});
 const control={getRuntime:async({session})=>leases.get(session)??empty(),register:async x=>{const s={...empty(),generation:x.generation,leaseExpiresAtMs:Date.now()+30000};leases.set(x.session,s);return s;},configure:async x=>{const s={...leases.get(x.session),sessionPolicyRevision:1};leases.set(x.session,s);return s;},renew:async x=>leases.get(x.session),revoke:async()=>{},release:async()=>{}};
 const receipts=new Map();
 const confirm=command=>{view.revision++;view.pendingActions=view.pendingActions.filter(p=>p.id!==command.payload.pendingId);const receipt={success:true,commandId:command.commandId,revision:view.revision,replayed:false};receipts.set(command.commandId,receipt);return receipt;};
 if(recoveredCommand)confirm(recoveredCommand);
 const engine={project:async({audience})=>audience==='gm'?{...structuredClone(view),audience,gmNotes:'DO NOT SEND GM NOTES'}:{campaignId:view.campaignId,audience,revision:view.revision,currentSceneId:view.currentSceneId,directorMode:view.directorMode,authorityEpoch:view.authorityEpoch},command:async command=>{await beforeCommand(command);commands.push(structuredClone(command));const receipt=unresolved?null:confirm(command);if(ambiguous||unresolved)throw Object.assign(new Error('lost response'),{code:'ENGINE_UNAVAILABLE'});return receipt;},receipt:async input=>{recoveries.push(structuredClone(input));const receipt=receipts.get(input.commandId);if(receipt)return {...receipt,replayed:true};throw Object.assign(new Error('not found'),{code:'RECEIPT_NOT_FOUND',status:404});}};
 const host={engine,authorize:async()=>member,onCommitted:fn=>{observer=fn;return()=>{};},refreshPublic:async()=>{onRefresh(view);return true;}};
 const ai=await createCampaignAI({host,campaignId:'fixture',gmUserId:'gm',baseUrl:'http://127.0.0.1:38175',serviceToken:'a'.repeat(64),hostControlToken:'b'.repeat(64),artDirectory:join(directory,'art'),directorRecoveryFile:omitRecovery?undefined:recoveryFile??join(directory,'recovery','fixture.sqlite'),directorStore,control,transport:{generate:async input=>{requests.push(input);return generate(input);},runtime:async()=>({contract:'raph-obus-game-runtime-v1',...empty()})},partyFactory:()=>({start(){},close(){},getPrivateIntents:()=>[],onDecisionOpened:async()=>({status:'complete',committed:[]})}),imageFactory:()=>({request:async()=>({status:'retained'})})});
 const notify=async()=>{await observer({scope:{campaignId:'fixture',userId:'player',actorId:'lantern-fighter',audience:'private',action:'describe'},receipt:{success:true,revision:view.revision,commandId:'intent-4',replayed:false}});};
 return {ai,directory,view,requests,commands,recoveries,confirm:()=>{unresolved=false;return confirm(commands[0]);},notify,revoke:()=>{member=false;},emit:async()=>{view.pendingActions=Array.from({length:pendingCount},(_,i)=>({id:`intent-${4+i}`,kind:'describe',actorId:'lantern-fighter',text:'I listen at the door.'}));await notify();},close:async({keep=false}={})=>{await ai.close();if(!keep)await rm(directory,{recursive:true,force:true});}};
}
test('persisted AI mode runs a private narrative ruling through the delegated engine principal',async()=>{const f=await fixture();try{await f.emit();await waitFor(directorStatus(f,'committed'));assert.equal(f.requests.length,1);assert.equal(f.commands.length,1);assert.equal(f.commands[0].ownerId,'ai-director:fixture');assert.equal(f.commands[0].authorityEpoch,1);assert.equal(f.commands[0].expectedRevision,4);assert.equal(f.commands[0].type,'gm_resolve');assert.equal(f.commands[0].payload.pendingId,'intent-4');assert.deepEqual(f.requests[0].policy,{enabled:true,mode:'local',exportable:false,codex:false});assert(!JSON.stringify(f.requests[0].evidence).includes('DO NOT SEND GM NOTES'));assert.equal(f.requests[0].scope.role,'host');assert(!Object.hasOwn(f.requests[0].evidence,'question'));assert(!Object.hasOwn(f.requests[0].evidence,'contract'));}finally{await f.close();}});
test('human GM mode does not invoke a director model',async()=>{const f=await fixture({mode:'human_gm'});try{await f.emit();await f.ai.close();assert.equal(f.requests.length,0);assert.equal(f.commands.length,0);}finally{await f.close();}});
test('late inference cannot gain replacement authority after handoff',async()=>{let resolve;const wait=new Promise(r=>resolve=r);const f=await fixture({generate:()=>wait});try{await f.emit();await waitFor(()=>f.requests.length===1);assert.equal(f.requests.length,1);f.view.authorityEpoch=3;f.view.aiDirectorId='ai-director:replacement';resolve(result());await f.ai.close();assert.equal(f.commands.length,0);}finally{resolve(result());await f.close();}});
test('untrusted route trace and revoked membership prevent director commits',async()=>{for(const which of ['route','member']){const f=await fixture({generate:()=>which==='route'?{...result(),trace:[{destination:'cloud'}]}:result()});try{if(which==='member')f.revoke();await f.emit();if(which==='route')await waitFor(directorStatus(f,'unavailable'));await f.ai.close();assert.equal(f.commands.length,0);}finally{await f.close();}}});
test('ambiguous dispatch recovers its original receipt without issuing another command',async()=>{const f=await fixture({ambiguous:true});try{await f.emit();await waitFor(directorStatus(f,'recovered'));assert.equal(f.commands.length,1);assert.equal(f.recoveries.at(-1).commandId,f.commands[0].commandId);assert.equal(f.recoveries.at(-1).ownerId,'ai-director:fixture');}finally{await f.close();}});
test('pending player rolls and malformed model instructions cannot become rulings',async()=>{for(const pendingRoll of [true,false]){const f=await fixture({generate:()=>({...result(),text:JSON.stringify({approved:true,text:'override',type:'gm_owner'})})});try{f.view.rollPending=pendingRoll;await f.emit();if(!pendingRoll)await waitFor(directorStatus(f,'unavailable'));await f.ai.close();assert.equal(f.commands.length,0);assert.equal(f.requests.length,pendingRoll?0:1);}finally{await f.close();}}});
test('confirmed rulings drain two pending intentions without journal callbacks',async()=>{for(const ambiguous of [false,true]){const f=await fixture({pendingCount:2,ambiguous});try{await f.emit();await waitFor(()=>f.ai.status().lastDirector?.revision===6);assert.equal(f.commands.length,2);assert.equal(f.requests.length,2);assert.deepEqual(f.commands.map(c=>c.expectedRevision),[4,5]);assert.equal(f.view.pendingActions.length,0);}finally{await f.close();}}});
test('uncertain sends remain receipt-only across later events and handoff',async()=>{const f=await fixture({pendingCount:2,unresolved:true});try{await f.emit();await waitFor(directorStatus(f,'receipt-unknown'));const original=structuredClone(f.commands[0]);let reads=f.recoveries.length;await f.notify();await waitFor(()=>f.recoveries.length>reads);assert.equal(f.requests.length,1);assert.equal(f.commands.length,1);assert.equal(f.ai.status().lastDirector.status,'receipt-unknown');f.view.authorityEpoch=2;f.view.aiDirectorId='ai-director:replacement';reads=f.recoveries.length;await f.notify();await waitFor(()=>f.recoveries.length>reads);assert.equal(f.requests.length,1);assert.equal(f.recoveries.at(-1).ownerId,original.ownerId);f.confirm();await f.notify();await waitFor(()=>f.ai.status().lastDirector?.revision===6);assert.equal(f.commands.length,2);assert.equal(f.commands[1].authorityEpoch,2);assert.equal(f.commands[1].ownerId,'ai-director:replacement');assert.equal(f.commands[1].expectedRevision,5);assert.deepEqual(f.commands[0],original);}finally{await f.close();}});
test('continuation rechecks handoff before another inference',async()=>{const f=await fixture({pendingCount:2,onRefresh:view=>{view.directorMode='human_gm';view.authorityEpoch++;}});try{await f.emit();await waitFor(()=>f.view.directorMode==='human_gm');await f.ai.close();assert.equal(f.commands.length,1);assert.equal(f.requests.length,1);assert.equal(f.view.pendingActions.length,1);}finally{await f.close();}});
test('automatic director continuation is bounded to three rulings per event',async()=>{const f=await fixture({pendingCount:5});try{await f.emit();await waitFor(()=>f.ai.status().lastDirector?.revision===7);assert.equal(f.commands.length,3);assert.equal(f.view.pendingActions.length,2);await f.notify();await waitFor(()=>f.ai.status().lastDirector?.revision===9);assert.equal(f.commands.length,5);}finally{await f.close();}});
