function signedHost(t, { afterRead = () => {}, afterWrite = () => {} } = {}) {
  const db = new DatabaseSync(':memory:'); t.after(() => db.close());
  const now = () => 1_000_000;
  const authority = structuredClone(runtime);
  authority.leaseExpiresAtMs = now() + 30_000;
  Object.assign(authority.effectivePolicy, { enabled: false, mode: 'local', exportable: false });
  const writes = [], reads = [], membership = [];
  const access = { role: 'host' };
  const host = { campaign: 'a', owner: 'gm', role: 'host' };
  const control = createObusHostControl({ url: 'http://127.0.0.1:38175', serviceToken: 'a'.repeat(64), hostControlToken: 'b'.repeat(64), now, nonce: () => 'c'.repeat(64),
    fetchImpl: async (url, options) => {
      assert.equal(url, 'http://127.0.0.1:38175/api/game/runtime'); assert.equal(options.method, 'PATCH');
      assert.equal(options.redirect, 'error'); assert.equal(options.credentials, 'omit');
      const hash = createHash('sha256').update(options.body).digest('hex');
      const signed = ['PATCH', '/api/game/runtime', '1000', 'c'.repeat(64), hash].join('\n');
      assert.equal(options.headers['X-Obus-Game-Host-Signature'], createHmac('sha256', Buffer.from('b'.repeat(64), 'hex')).update(signed).digest('hex'));
      const body = JSON.parse(options.body); writes.push(body);
      assert.equal(body.expectedSessionPolicyRevision, authority.sessionPolicyRevision);
      authority.sessionPolicyRevision++;
      Object.assign(authority.effectivePolicy, body.policy);
      afterWrite(access);
      return Response.json(authority);
    } });
  const ai = new GameAi({ db, now, configureRuntime: input => control.configure(input),
    transport: { runtimeState: async (scope, session) => { reads.push({ ...scope, session }); const value = structuredClone(authority); afterRead(access); return value; } },
    authorize: () => { membership.push(access.role); return access.role; } });
  const input = (mode, extra = {}) => ({ mode, codex: false, requestId: '33333333-3333-4333-8333-333333333333', expectedBootEpoch: authority.bootEpoch, expectedGeneration: authority.generation, expectedSessionPolicyRevision: authority.sessionPolicyRevision, ...extra });
  return { ai, host, authority, access, writes, reads, membership, input };
}

test('explicit GM modes sign the campaign export ceiling and preserve enabled state and revision fences', async t => {
  const f = signedHost(t);
  const free = await f.ai.configure(f.host, 'campaign', f.input('local-free'));
  assert.deepEqual(f.writes[0], { contract: runtime.contract, campaign: 'a', session: 'campaign', expectedBootEpoch: runtime.bootEpoch, expectedGeneration: runtime.generation, expectedSessionPolicyRevision: 3, opId: '33333333-3333-4333-8333-333333333333', policy: { enabled: false, mode: 'local-free', exportable: true, codex: false } });
  assert.equal(free.exportable, true); assert.equal(free.enabled, false); assert.equal(free.sessionPolicyRevision, 4);
  const local = await f.ai.configure(f.host, 'campaign', f.input('local', { enabled: true, requestId: '44444444-4444-4444-8444-444444444444' }));
  assert.deepEqual(f.writes[1].policy, { enabled: true, mode: 'local', exportable: false, codex: false });
  assert.equal(local.sessionPolicyRevision, 5); assert.deepEqual(f.membership, Array(6).fill('host'));
  assert.deepEqual(f.reads, [{ campaign: 'a', session: 'campaign' }, { campaign: 'a', session: 'campaign' }]);
  assert.equal(JSON.stringify(local).includes('b'.repeat(64)), false);
});

test('GM authority withdrawal before the signed write prevents any policy dispatch', async t => {
  const f = signedHost(t, { afterRead: access => { access.role = 'player'; } });
  await assert.rejects(f.ai.configure(f.host, 'campaign', f.input('local-free')), /membership/);
  assert.equal(f.writes.length, 0); assert.equal(f.authority.sessionPolicyRevision, 3); assert.equal(f.authority.effectivePolicy.exportable, false);
});

test('GM authority withdrawal during a signed write withholds the result without retrying', async t => {
  const f = signedHost(t, { afterWrite: access => { access.role = 'player'; } });
  await assert.rejects(f.ai.configure(f.host, 'campaign', f.input('local-free')), /membership/);
  assert.equal(f.writes.length, 1); assert.equal(f.authority.sessionPolicyRevision, 4);
  assert.equal(f.ai.db.prepare('SELECT count(*) AS n FROM ai_jobs').get().n, 0);
});

test('stale fences, expired authority, players and unsupported Codex cannot sign a policy change', async t => {
  for (const variant of ['stale', 'expired', 'player', 'codex']) {
    await t.test(variant, async t => {
      const f = signedHost(t); let input = f.input('local-free'), actor = f.host;
      if (variant === 'stale') input.expectedSessionPolicyRevision--;
      if (variant === 'expired') f.authority.leaseExpiresAtMs = 1_000_000;
      if (variant === 'player') { actor = { ...actor, role: 'player' }; f.access.role = 'player'; }
      if (variant === 'codex') input.codex = true;
      await assert.rejects(f.ai.configure(actor, 'campaign', input));
      assert.equal(f.writes.length, 0); assert.equal(f.authority.sessionPolicyRevision, 3); assert.equal(f.authority.effectivePolicy.exportable, false);
    });
  }
});

test('free readiness requires verified availability and a live runtime permission, with no raw metadata exposure', async t => {
  const variants = [
    ['ready', {}, {}, true],
    ['capability absent', { verified_free_route_fallback: undefined }, {}, false],
    ['capability nonboolean', { verified_free_route_fallback: 'true' }, {}, false],
    ['route absent', { free_route_ready: undefined }, {}, false],
    ['route unavailable', { free_route_ready: false }, {}, false],
    ['route nonboolean', { free_route_ready: 'true' }, {}, false],
    ['local mode', {}, { mode: 'local' }, false],
    ['export disabled', {}, { exportable: false }, false],
    ['runtime disabled', {}, { enabled: false }, false],
    ['all routing unavailable', { route_ready: false }, {}, false],
    ['lease expired', {}, {}, false],
    ['generation absent', {}, {}, false],
  ];
  for (const [name, capabilityPatch, policyPatch, expected] of variants) {
    await t.test(name, async t => {
      const authority = structuredClone(runtime); Object.assign(authority.effectivePolicy, policyPatch);
      if (name === 'lease expired') authority.leaseExpiresAtMs = 0;
      if (name === 'generation absent') authority.generation = null;
      const ai = setup(t, { runtimeState: async () => authority, capabilities: async () => ({ ...caps, verified_free_route_fallback: true, free_route_ready: true, privateRoute: 'SECRET_PROVIDER_ACCOUNT', ...capabilityPatch }) });
      const result = await ai.status(scope, 'campaign');
      assert.equal(result.remoteAvailable, expected); assert.equal(result.remoteReadiness, expected ? 'ready' : 'unavailable');
      assert.equal(JSON.stringify(result).includes('SECRET_PROVIDER_ACCOUNT'), false);
      if (!expected) assert.equal(typeof result.reason, 'string');
    });
  }
});

test('readiness withholds fresh capabilities after membership revocation and sanitizes provider failure', async t => {
  const ai = setup(t, { capabilities: async () => { throw Error('SECRET_PROVIDER_ACCOUNT'); } });
  const unavailable = await ai.status(scope);
  assert.equal(unavailable.remoteAvailable, false); assert.equal(unavailable.ready, false); assert.equal(JSON.stringify(unavailable).includes('SECRET_PROVIDER_ACCOUNT'), false);
  let checks = 0;
  ai.authorize = () => ++checks === 1 ? 'player' : undefined;
  ai.transport.capabilities = async () => ({ ...caps, verified_free_route_fallback: true, free_route_ready: true });
  await assert.rejects(ai.status(scope), /membership/);
});

