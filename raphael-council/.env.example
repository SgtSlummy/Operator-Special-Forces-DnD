# Copy to .env.local and fill in locally. Never share or commit the bot token.
DISCORD_TOKEN=
RAPHAEL_GUILD_ID=
RAPHAEL_CHANNEL_ID=
RAPHAEL_CAMPAIGN_ID=greyharbor
# Require the campaign role OR explicitly listed current server members.
RAPHAEL_PLAYER_ROLE_ID=
RAPHAEL_PLAYER_IDS=
# Optional. Default: local application data/Raphael/character-importer (outside OneDrive).
RAPHAEL_DATA_DIR=

# Tactical campaign state. Both gameplay interfaces must use the same directory.
# Default: local application data/Raphael/game (outside OneDrive).
RAPHAEL_GAME_DATA_DIR=

# Obus is the only game AI backend. Provider credentials stay in Obus.
# Private Obus game agent; never expose this port through the public tunnel.
RAPHAEL_OBUS_URL=http://127.0.0.1:38175
# Optional token file override. Default: ~/.occultbus/game-agent/service-token
RAPHAEL_OBUS_TOKEN_FILE=

# Discord browser OAuth and Activity share this existing application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
RAPHAEL_PUBLIC_ORIGIN=
RAPHAEL_DM_ROLE_ID=
RAPHAEL_DM_IDS=

# Enable only after the existing bot has Message Content intent and voice permissions.
# Each participant still opts in with /session consent. External story processing stays off.
RAPHAEL_CHRONICLE_ENABLED=0
# Default: same as RAPHAEL_CHANNEL_ID.
RAPHAEL_JOURNAL_CHANNEL_ID=
# Default: local application data/Raphael/chronicle/<campaign> (outside OneDrive).
RAPHAEL_CHRONICLE_DATA_DIR=

# Runtime scene images use Obus when its local image capability is ready.
# Both Discord and the Node browser host must use the same image data directory.
# Default: local application data/Raphael/scene-images (outside OneDrive).
RAPHAEL_IMAGE_DATA_DIR=
# Optional absolute path if moving the 66-image Witnesslight library.
RAPHAEL_ART_ROOT=
